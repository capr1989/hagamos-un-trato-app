{
  "name": "hagamos-un-trato-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:repository": "node scripts/check-repository.mjs",
    "test": "npm run test:db",
    "test:db": "node tests/database/run.mjs",
    "test:db:supabase-local": "node tests/database/run.mjs --supabase-local && node tests/database/report-concurrency.mjs",
    "validate": "npm run check:repository && npm run typecheck && npm run test:qa && npm run test:reports && npm run test:db",
    "test:reports": "node --test tests/company-reports.test.mjs",
    "reports:smoke-http": "node tests/report-http-smoke.mjs",
    "db:local:start": "supabase start",
    "db:local:reset": "supabase db reset",
    "db:local:stop": "supabase stop",
    "qa:dev": "next dev --hostname 127.0.0.1",
    "qa:start": "next start --hostname 127.0.0.1",
    "qa:bootstrap": "node --env-file=.env.local scripts/qa-bootstrap.mjs",
    "test:qa": "node --test tests/qa-policy.test.mjs tests/qa-bootstrap.test.mjs",
    "qa:smoke-public": "node --env-file=.env.local scripts/qa-public-smoke.mjs",
    "qa:smoke-http": "node --env-file=.env.local tests/qa-http-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.1",
    "supabase": "3.2.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
