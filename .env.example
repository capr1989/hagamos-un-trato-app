# Public project identifier supplied by the user; NOT a secret or proof of an operational link.
NEXT_PUBLIC_SUPABASE_URL=https://lewlduoqmsdnmxfichus.supabase.co
# Replace locally with the project's publishable key only after MCP verification.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Never commit a real .env file or a secret/service-role key.
# Local tests need no remote credentials and refuse remote database URLs.

NEXT_TELEMETRY_DISABLED=1

# Temporary LOCAL QA panel. Disabled unless explicitly enabled in .env.local.
HUT_QA_ENABLED=false
HUT_QA_ORIGIN=http://127.0.0.1:3000
# Optional operator key: server-only user creation/bootstrap. Never NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=REPLACE_ME_LOCALLY
# The one-use bootstrap also requires an explicit process environment opt-in.
