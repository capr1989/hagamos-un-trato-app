# Public project identifier supplied by the user; NOT a secret or proof of an operational link.
NEXT_PUBLIC_SUPABASE_URL=https://lewlduoqmsdnmxfichus.supabase.co
# Replace locally with the project's publishable key only after MCP verification.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Never commit a real .env file or a secret/service-role key.
# Local tests need no remote credentials and refuse remote database URLs.

NEXT_TELEMETRY_DISABLED=1

# Temporary LOCAL QA panel. Disabled unless explicitly enabled in .env.local.
HUT_QA_ENABLED=false
HUT_QA_ORIGIN=http://127.0.0.1:3000
# Optional operator key: server-only user creation/bootstrap. Never NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=REPLACE_ME_LOCALLY
# The one-use bootstrap also requires an explicit process environment opt-in.

# Private quality reports. Fail closed until ALL dependencies are configured.
HUT_REPORTS_ENABLED=false
# SUPABASE_SECRET_KEY above is also required for the controlled server-only RPC.
# TURNSTILE_SECRET_KEY=REPLACE_ME_LOCALLY
# HUT_REPORTS_ORIGIN_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET_AT_LEAST_32_CHARACTERS
# HUT_REPORTS_PRIVACY_NOTICE_VERSION=APPROVED_NOTICE_VERSION
# Exact origins/hostnames, comma-separated. No wildcard or path.
# HUT_REPORTS_ALLOWED_ORIGINS=https://your-approved-domain.example
# HUT_REPORTS_ALLOWED_HOSTNAMES=your-approved-domain.example
# Future Vercel deployment only; VERCEL=1 is supplied by that platform.
HUT_REPORTS_IP_SOURCE=vercel
# For local QA: loopback, NODE_ENV!=production, HUT_QA_ENABLED=true,
# origin http://127.0.0.1:3000 and the exact Turnstile hostname.
# Local mode still requires real CAPTCHA verification and a server-only key.
